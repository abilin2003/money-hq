# Copy to .env.test.local (never committed) and fill in from your separate TEST Supabase project.
# Never put your real Money HQ project here, and never a secret / service_role key.
TEST_SUPABASE_URL=https://your-test-project-ref.supabase.co
TEST_SUPABASE_PUBLISHABLE_KEY=sb_publishable_from_the_test_project
TEST_USER_A_EMAIL=test-a@example.test
TEST_USER_A_PASSWORD=a-made-up-password-for-the-test-project-only
TEST_USER_B_EMAIL=test-b@example.test
TEST_USER_B_PASSWORD=another-made-up-password-for-the-test-project-only
