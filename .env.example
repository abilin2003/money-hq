# Copy this file to .env.local and fill in the two values from Supabase:
#   Project Settings > Data API > Project URL
#   Project Settings > API Keys > Publishable key  (starts with sb_publishable_)
# NEVER put the secret key (sb_secret_... or service_role) here or anywhere in this repo.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
